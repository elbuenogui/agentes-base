# OS
.DS_Store
Thumbs.db

# Rascunho descartável do modo PM/EXEC (ver .claude/estado/README.md)
.claude/tmp/

# Segredos locais — nunca commitar a chave da API (usar transcritor/.env.example como modelo)
transcritor/.env

# Registro local de consumo (tokens/custo por requisição) — dado local, não versionado
transcritor/consumo.jsonl

# Registro local das transcrições (texto), ligado a consumo.jsonl pelo id — dado local, não versionado
transcritor/transcricoes.jsonl

# Ambiente virtual e caches do Python — locais, não versionar
transcritor/.venv/
transcritor/backend/__pycache__/

# Lixo do bridge remoto: arquivos apagados enquanto estavam abertos pela pasta montada.
# A pasta montada não permite apagá-los ("Operation not permitted"), então eles são movidos
# para _to_delete/ e removidos por quem roda local. Ignorados para não serem commitados sem querer.
.fuse_hidden*
_to_delete/
