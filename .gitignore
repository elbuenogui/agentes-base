# OS
.DS_Store
Thumbs.db

# Rascunho descartável do modo PM/EXEC (ver .claude/estado/README.md)
.claude/tmp/

# Segredos locais — nunca commitar a chave da API (usar transcritor/.env.example como modelo)
transcritor/.env

# Registro local de consumo (tokens/custo por requisição) — dado local, não versionado
transcritor/consumo.jsonl

# Registro local das transcrições (texto), ligado a consumo.jsonl pelo id — dado local, não versionado
transcritor/transcricoes.jsonl

# Ambiente virtual e caches do Python — locais, não versionar
transcritor/.venv/
__pycache__/

# Lixo do bridge remoto: arquivos apagados enquanto estavam abertos pela pasta montada.
# A pasta montada não permite apagá-los ("Operation not permitted"), então eles são movidos
# para _to_delete/ e removidos por quem roda local. Ignorados para não serem commitados sem querer.
.fuse_hidden*
_to_delete/

# Logs do servidor local, deixados por sessões de teste — nunca versionar
uvicorn*.log

# App de desktop: __pycache__/ já cai na regra global acima. Log solto de teste (redirecionamento
# de saída de processo), nunca versionar — mas app.log é o registro de diagnóstico do app (SPEC-002),
# esse continua existindo e não entra nesta regra.
desktop/*.log
!desktop/app.log

# Logs do núcleo remoto (importador e testes, saída de cada execução) — locais, nunca versionar
nucleo-remoto/banco/*.log
nucleo-remoto/testes/*.log

# Sessão do Supabase do app de desktop — mora em %APPDATA%\agentes-base\ (fora do repositório);
# esta linha é só a rede de proteção para uma cópia nunca entrar no git por engano
sessao.json
sessao.json.tmp
